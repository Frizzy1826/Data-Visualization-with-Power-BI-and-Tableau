      <aliases enabled='yes' />
      <column caption='Physics_Clean' datatype='real' name='[Calculation_1262279676612608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_Clean' datatype='real' name='[Calculation_1262279676825601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Math_Clean' datatype='real' name='[Calculation_1262279677120514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean' datatype='integer' name='[Calculation_1262279677251587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry], 0)' />
      </column>
      <column caption='Clean_Score' datatype='real' name='[Calculation_1262279678873604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Pivot Field Values]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_1262279680028677]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_1262279681536006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1262279677120514] + [Calculation_1262279676612608] + [Calculation_1262279677251587] +&#13;&#10;[Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' default-format='p0.0%' name='[Calculation_1262279681679367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1262279681536006] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_1262279682150408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1262279681679367] &gt;= 0.85 THEN &quot;Distinction&quot;&#13;&#10;ELSEIF [Calculation_1262279681679367] &gt;= 0.75 THEN &quot;First Class&quot;&#13;&#10;ELSEIF [Calculation_1262279681679367] &gt;= 0.60 THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot;&#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_1262279682314249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1262279676825601] &gt;= 75 THEN &quot;Eligible (Good Standing)&quot;&#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_1262279683055626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Department] : AVG([Calculation_1262279681679367]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' default-format='p0.0%' name='[Calculation_1262279683977227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_1262279681679367]) }' />
      </column>
      <column caption='Variance_From_Dept_Average' datatype='real' default-format='p0.0%' name='[Calculation_1262279684247564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1262279681679367] - [Calculation_1262279683055626]' />
      </column>
      <column caption='Benchmark_Status' datatype='string' name='[Calculation_1262279684558861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1262279684247564] &gt;= 0 THEN &quot;Above Department&#13;&#10;Benchmark&quot;&#13;&#10;ELSE &quot;Below Department Benchmark&quot;&#13;&#10;END' />
      </column>
      <column caption='Full_Name_Clean' datatype='string' name='[Calculation_1262279685181454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(TRIM([Full_Name]), 1)) +&#13;&#10;LOWER(MID(TRIM([Full_Name]), 2, FIND(TRIM([Full_Name]), &quot; &quot;) -&#13;&#10;1)) +&#13;&#10;&quot; &quot; +&#13;&#10;UPPER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 1,&#13;&#10;1)) +&#13;&#10;LOWER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 2,&#13;&#10;LEN(TRIM([Full_Name]))))' />
      </column>
