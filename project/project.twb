      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_1776586945679360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales])' />
      </column>
      <column caption='Total Games' datatype='integer' name='[Calculation_1776586945830913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Name])' />
      </column>
      <column caption='Average Global Sales' datatype='real' name='[Calculation_1776586945961986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Global_Sales])' />
      </column>
      <column caption='Sales Contribution Ration' datatype='real' name='[Calculation_1776586946187267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) / TOTAL(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Map Region' datatype='string' name='[Calculation_1776586956558341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;NA_Sales&quot; THEN &quot;North America&quot;&#13;&#10;ELSEIF [Pivot Field Names] = &quot;EU_Sales&quot; THEN &quot;Europe&quot;&#13;&#10;ELSEIF [Pivot Field Names] = &quot;JP_Sales&quot; THEN &quot;Japan&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Map Latitude' datatype='integer' name='[Calculation_1776586956705798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;NA_Sales&quot; THEN 40&#13;&#10;ELSEIF [Pivot Field Names] = &quot;EU_Sales&quot; THEN 50&#13;&#10;ELSEIF [Pivot Field Names] = &quot;JP_Sales&quot; THEN 36&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Map Longitude' datatype='integer' name='[Calculation_1776586956804103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;NA_Sales&quot; THEN -100&#13;&#10;ELSEIF [Pivot Field Names] = &quot;EU_Sales&quot; THEN 10&#13;&#10;ELSEIF [Pivot Field Names] = &quot;JP_Sales&quot; THEN 138&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Critic Count' datatype='integer' name='[Critic_Count]' role='measure' type='quantitative' />
      <column caption='Critic Score' datatype='integer' name='[Critic_Score]' role='measure' type='quantitative' />
      <column caption='Global Sales' datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
      <column caption='Region' datatype='string' name='[Pivot Field Names]' role='dimension' type='nominal' />
      <column caption='Regional Sales' datatype='real' name='[Pivot Field Values]' role='measure' type='quantitative' />
      <column caption='Regional Sales map' datatype='real' name='[Regional Sales (copy)_1776586956480516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pivot Field Values]' />
      </column>
