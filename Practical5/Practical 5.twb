      <aliases enabled='yes' />
      <column caption='Cummulative Votes' datatype='integer' name='[Calculation_0098442790477825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restaurant Rank' datatype='integer' name='[Calculation_0098442792161282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Avg Cost' datatype='real' name='[Calculation_0098442793549827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference from Window Sum' datatype='real' name='[Calculation_0098442795110404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dynamic Title' datatype='string' name='[Calculation_0098442798350343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top&quot; +STR([Parameters].[Parameter 0098442797785094]) + &quot;Restaurants by Total Votes&quot;' />
      </column>
